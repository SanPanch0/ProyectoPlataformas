# Copia este archivo como .env y rellena SOLO las claves que tengas.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore) y NUNCA llega al navegador:
# lo lee únicamente el servidor (server.js en local, o las funciones /api en Vercel).
# Si una clave queda vacía, la aplicación usa automáticamente la alternativa gratuita sin clave.

# REST Countries v5 (información del país). Registro: https://restcountries.com/sign-up
RESTCOUNTRIES_API_KEY=

# Unsplash (fotografías). Usa la "Access Key" de tu aplicación: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=
# Nombre de tu aplicación en Unsplash (se usa en los enlaces de atribución utm_source).
UNSPLASH_APP_NAME=guia_global_de_viajes

# RapidAPI (hoteles de Booking.com). Clave de la app en https://rapidapi.com/developer/apps
RAPIDAPI_KEY=
# Host de la API "Booking COM" (proveedor DataCrawler) en RapidAPI.
RAPIDAPI_BOOKING_HOST=booking-com15.p.rapidapi.com

# Tripadvisor Terra API (opcional: foto y puntuación de hoteles, sin precios). Clave en https://www.tripadvisor.com/developers
# (la Content API antigua se cerró el 31-ago-2026; sus claves ya no sirven). Plan gratis: 1 000 consultas por cuenta, una sola vez.
TRIPADVISOR_API_KEY=

# Puerto del servidor local (opcional).
PORT=3000
